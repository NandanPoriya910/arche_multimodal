PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/secure_rag
# or your Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure_rag

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars

CORS_ORIGIN=http://localhost:5173

# Sign in with Google (optional). OAuth 2.0 Client ID of type "Web application";
# add http://localhost:5173 under "Authorized JavaScript origins". Use the SAME id in frontend/.env (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
DATA_DIR=./data
MAX_UPLOAD_MB=25
SEED_DEFAULT_USERS=true

RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.12
